<configs>

	<!-- ============================================================ -->
	<!-- Backpack grid: V3.3 layout                                   -->
	<!-- V3.3 put the backpack grid inside a scrollview, 8 wide by 12 -->
	<!-- rows (96 cells) at 73px, so the bag no longer has to fit on  -->
	<!-- screen at once. The grid builds one item-stack controller    -->
	<!-- per cell when the window initialises, and slots past that    -->
	<!-- pool never render, so it needs one cell per bag slot:        -->
	<!-- 8 x 17 = 136. Width, height and header stay vanilla; the     -->
	<!-- extra rows scroll.                                           -->
	<!-- ============================================================ -->

	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/scrollview/grid[@name='inventory']/@rows">17</set>

	<!-- The loot window builds ONE pool of item-stack controllers from this grid's rows x cols -->
	<!-- (90 in vanilla) and hides the spares; a container with more slots than the pool simply -->
	<!-- never renders them. The dropped-death bag is 13x11 = 143; 13x12 = 156 also covers -->
	<!-- KitsuneStorage's 144-slot steel crate, since whichever of the two mods loads last sets -->
	<!-- this pool. Columns/Rows are set per-container at open time, so other containers are unaffected. -->
	<!-- // matches the grid with or without V3.3's scrollview wrapper. -->
	<set xpath="/windows/window[@name='windowLooting']//grid[@name='queue']/@cols">13</set>
	<set xpath="/windows/window[@name='windowLooting']//grid[@name='queue']/@rows">12</set>

</configs>

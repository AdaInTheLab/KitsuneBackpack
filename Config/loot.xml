<configs>

	<!-- Dropped-on-death / dropped-item backpack container: vanilla 7x10 = 70 cannot hold a full 136 bag. -->
	<!-- 13x11 = 143 rather than matching the bag's 17-wide shape: the loot window sits in the LEFT stack -->
	<!-- panel with the 1145-wide backpack in Center, and the panels are packed side by side, so every -->
	<!-- loot column costs 75px of a screen the backpack has already mostly eaten. 13 cols = 975px wide -->
	<!-- instead of 1275. 11 rows is one past vanilla's deepest container (10) and still clears the -->
	<!-- toolbelt; 12 would have reached into it. -->
	<set xpath="/lootcontainers/lootcontainer[@name='playerBackpack']/@size">13,11</set>

</configs>
